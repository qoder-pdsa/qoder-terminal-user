USER_PORT=8084
USER_DB_URL=jdbc:postgresql://localhost:5432/qoder
USER_DB_USERNAME=qoder
USER_DB_PASSWORD=
# PKCS#8 PEM private key, injected from a KMS secret in production:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
USER_JWT_PRIVATE_KEY=
# Set to true only for local development
USER_JWT_ALLOW_EPHEMERAL=false
USER_TOKEN_TTL=PT8H
# Leave empty to disable registration
USER_INVITE_CODE=
