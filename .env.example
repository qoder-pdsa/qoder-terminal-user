USER_PORT=8084
USER_DB_URL=jdbc:postgresql://localhost:5432/qoder
USER_DB_USERNAME=qoder
USER_DB_PASSWORD=
# PKCS#8 PEM 私钥，生产环境从 KMS 凭据注入：
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
USER_JWT_PRIVATE_KEY=
# 仅本地开发可设为 true
USER_JWT_ALLOW_EPHEMERAL=false
USER_TOKEN_TTL=PT8H
# 为空则关闭注册
USER_INVITE_CODE=
